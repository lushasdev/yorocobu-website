---
/**
 * The two founder cards, ported from the previous site. Names and titles only,
 * which is all that is public.
 *
 * The source photographs are 840KB and 1.6MB PNGs. astro:assets resizes them and
 * emits WebP with correct intrinsic dimensions, which is what actually moves the
 * Lighthouse number.
 */
import { Image } from 'astro:assets'
import ethan from '../assets/ethan-gailushas.png'
import bence from '../assets/bence-burton.png'

const people = [
  { name: 'Ethan Gailushas', title: 'Co-Founder', image: ethan },
  { name: 'Bence Burton', title: 'Co-Founder', image: bence },
]
---

<div class="people">
  {
    people.map(({ name, title, image }) => (
      <figure class="person">
        <Image src={image} alt={name} width={480} height={480} format="webp" quality={72} />
        <figcaption>
          <p class="person__name">{name}</p>
          <p class="person__title mono">{title}</p>
        </figcaption>
      </figure>
    ))
  }
</div>
