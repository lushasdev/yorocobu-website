---
/**
 * The escape hatch, for either language tree.
 *
 * Everything on the site, properly typeset, in the same palette and type system.
 * Some visitors would rather read than converse, and this is for them: it is the
 * better-lit path, not a punishment. It is also the document crawlers and link
 * previews see in full — in both languages, which is the point of two real URL
 * trees rather than a client-side swap.
 */
import Base from '../layouts/Base.astro'
import Founders from './Founders.astro'
import knowledge from '../generated/knowledge.json'
import { useTranslations, pathForLocale, defaultLocale, type Locale } from '../i18n/ui.ts'
import '../styles/content.css'

interface Props {
  locale?: Locale
}

const { locale = defaultLocale } = Astro.props
const t = useTranslations(locale)
const { entries, generated } = knowledge
---

<Base title={t('index.title')} description={t('index.description')} locale={locale}>
  <main id="main" class="index-page">
    <header class="index-page__head">
      <p class="mono">
        Yorocobu &nbsp;//&nbsp; {t('index.kicker')} &nbsp;//&nbsp; {generated}
      </p>
      <h1>
        {t('index.heading')}<span class="index-page__jp jp">喜</span>
      </h1>
      <p class="index-page__lede">{t('index.lede', { count: entries.length })}</p>

      <nav aria-label={t('index.contentsLabel')}>
        <ol class="toc">
          {
            entries.map((entry, i) => (
              <li>
                <a href={`#${entry.id}`}>
                  <span class="toc__n">{String(i + 1).padStart(2, '0')}</span>
                  <span>{entry.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    {
      entries.map((entry) => (
        <article class="region" id={entry.id}>
          <header class="region__head">
            <p class="mono region__kicker">
              {entry.status}
              <span class="region__sep" aria-hidden="true">
                /
              </span>
              {t('index.updated', { date: entry.last_updated })}
            </p>
            <h2>{entry.title}</h2>
          </header>
          <div class="prose" set:html={entry.detailHtml} />
          {entry.id === 'founders' && <Founders />}
        </article>
      ))
    }

    <p class="index-page__direct">
      {t('index.direct')}
      <a href="mailto:ethan@yorocobu.org">ethan@yorocobu.org</a>.
    </p>

    <a class="back" href={pathForLocale('/', locale)}>
      <span class="back__mark" aria-hidden="true">◎</span>{t('index.back')}
    </a>
  </main>
</Base>
