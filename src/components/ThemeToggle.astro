---
/**
 * Manual light/dark override. Defaults to prefers-color-scheme; once the visitor
 * chooses, the choice is stored and wins in both directions.
 */
import { useTranslations, defaultLocale } from '../i18n/ui.ts'

interface Props {
  locale?: 'en' | 'ja'
}

const { locale = defaultLocale } = Astro.props
const t = useTranslations(locale)
---

<button class="theme" type="button" data-theme-toggle aria-pressed="false">
  <span class="theme__dot" aria-hidden="true"></span>
  <span class="visually-hidden">{t('theme.toggle')}</span>
  <span
    class="theme__label mono"
    aria-hidden="true"
    data-theme-label
    data-label-light={t('theme.light')}
    data-label-dark={t('theme.dark')}>{t('theme.light')}</span>
</button>

<style>
  .theme {
    position: fixed;
    top: calc(var(--frame-inset) + 14px);
    right: calc(var(--frame-inset) + 16px);
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: none;
    border: 0;
    padding: 4px;
    cursor: pointer;
  }

  .theme__dot {
    width: 9px;
    height: 9px;
    border: 1px solid var(--text-secondary);
    border-radius: 50%;
    background: linear-gradient(to right, var(--text-primary) 0 50%, transparent 50% 100%);
  }

  .theme__label {
    font-size: 0.66rem;
  }

  .theme:hover .theme__dot {
    border-color: var(--primary);
  }

  @media (max-width: 46rem) {
    .theme__label {
      display: none;
    }
  }
</style>

<script>
  const KEY = 'yorocobu:theme'
  const root = document.documentElement
  const button = document.querySelector('[data-theme-toggle]')
  const label = document.querySelector('[data-theme-label]')

  const current = () =>
    root.dataset.theme ??
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')

  /*
    The two words come from the dictionary via data attributes rather than from
    the theme value itself. `textContent = theme` was the shortest possible way
    to print "light" or "dark", and also the one place a locale could not reach.
  */
  const sync = () => {
    const theme = current()
    if (label) {
      label.textContent =
        (theme === 'dark' ? label.dataset.labelDark : label.dataset.labelLight) ?? theme
    }
    button?.setAttribute('aria-pressed', String(theme === 'dark'))
  }

  button?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark'
    root.dataset.theme = next
    try {
      localStorage.setItem(KEY, next)
    } catch {
      /* private mode; the choice simply will not persist */
    }
    sync()
  })

  // Track the system setting until the visitor overrides it.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (!root.dataset.theme) sync()
    })

  sync()
</script>
